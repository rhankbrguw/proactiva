PORT=4000
NODE_ENV=development
JWT_SECRET=supersecret_proactiva_jwt_key_2026

# PostgreSQL Database
DATABASE_URL="postgresql://proactiva_user:proactiva_password@localhost:5432/proactiva_db?schema=public"

# Redis
REDIS_HOST=localhost
